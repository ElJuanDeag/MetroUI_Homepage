{
  "name": "braje-cabo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --experimental-strip-types --watch server/server.ts",
    "build:client": "vite build --outDir dist-client",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "test": "npm run build:server && node --test dist-server/server/tests/*.test.js",
    "start": "node dist-server/server/server.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
