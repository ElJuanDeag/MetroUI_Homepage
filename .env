# Host port mappings for docker-compose.yml
# Copy this to .env on the server and adjust if NPM/Cloudflare Tunnel
# routing expects different ports.
#
# IMPORTANT: these MUST match whatever Nginx Proxy Manager / the
# Cloudflare Tunnel ingress config is currently pointing at, or you'll
# get a 502 after redeploying. Check NPM before changing these.

METRO_PORT=8181
CABO_PORT=3002